<!DOCTYPE html>
<html>
<head>
    <title>UIL Drill Tool</title>
</head>
<body>
    <div id="drill-box">
        <h2 id="question">Loading...</h2>
        <input type="text" id="answer" placeholder="Type answer here...">
        <button onclick="checkAnswer()">Submit</button>
        <p id="feedback"></p>
    </div>

    <script>
        // ADD YOUR UIL PROBLEMS HERE
        const uilQuestions = [
            { "q": "118 + 811 - 181 =", "a": "748" },
            { "q": "40 * 125 =", "a": "5000" },
            { "q": "17^2 =", "a": "289" },
  { "q": "118 + 811 - 181 =", "a": "748" },
  { "q": "40 * 125 =", "a": "5000" },
  { "q": "5/8 + 3/16 =", "a": "13/16" },
  { "q": "123 * 9 + 4 =", "a": "1111" },
  { "q": "17^2 =", "a": "289" },
  { "q": "3/40 =", "a": "0.075" },
  { "q": "16 * 28 + 16 * 22 =", "a": "800" },
  { "q": "11 / 2.5 =", "a": "4.4" },
  { "q": "Largest prime divisor of 76 is", "a": "19" },
  { "q": "158 * 262 =", "a": "41396" },
  { "q": "430 / 9 =", "a": "47 7/9" },
  { "q": "6 is what % less than 25?", "a": "76" },
  { "q": "80% of 80 minus 80 =", "a": "-16" },
  { "q": "1 2/5 + 1 5/7 =", "a": "3 4/35" },
  { "q": "MCXLVI =", "a": "1146" },
  { "q": "If 1 gram = 0.04 oz, then 120 grams =", "a": "4.8" },
  { "q": "GCD of 24, 36, and 48 is", "a": "12" },
  { "q": "1994 * 6 + 36 =", "a": "12000" },
  { "q": "Smallest prime number greater than 89 is", "a": "97" },
  { "q": "810210 / 159 =", "a": "5100" }
]
        ];

        let current = 0;

        function loadQuestion() {
            document.getElementById('question').innerText = uilQuestions[current].q;
        }

        function checkAnswer() {
            const userAns = document.getElementById('answer').value;
            if(userAns === uilQuestions[current].a) {
                document.getElementById('feedback').innerText = "Correct!";
            } else {
                document.getElementById('feedback').innerText = "Try again! Answer: " + uilQuestions[current].a;
            }
            current++;
            if(current < uilQuestions.length) loadQuestion();
        }

        loadQuestion();
    </script>
</body>
</html>
