<!DOCTYPE html>
<html>
<head>
    <title>UIL Drill Tool</title>
</head>
<body>
    <div id="drill-box">
        <h2 id="question">Loading...</h2>
        <input type="text" id="answer" placeholder="Type answer here...">
        <button onclick="checkAnswer()">Submit</button>
        <p id="feedback"></p>
    </div>

    <script>
        // ADD YOUR UIL PROBLEMS HERE
        const uilQuestions = [
            { "q": "118 + 811 - 181 =", "a": "748" },
            { "q": "40 * 125 =", "a": "5000" },
            { "q": "17^2 =", "a": "289" }
        ];

        let current = 0;

        function loadQuestion() {
            document.getElementById('question').innerText = uilQuestions[current].q;
        }

        function checkAnswer() {
            const userAns = document.getElementById('answer').value;
            if(userAns === uilQuestions[current].a) {
                document.getElementById('feedback').innerText = "Correct!";
            } else {
                document.getElementById('feedback').innerText = "Try again! Answer: " + uilQuestions[current].a;
            }
            current++;
            if(current < uilQuestions.length) loadQuestion();
        }

        loadQuestion();
    </script>
</body>
</html>
